// ─── Core Tenancy & Users ────────────────────────────────────────────────────

model Company {
  id                    String                  @id @default(auto()) @map("_id") @db.ObjectId
  /// Clerk org id (`org_…`) or synthetic `local:{clerkUserId}` when orgs are disabled.
  clerkOrganizationId   String?
  /// Unique 10-character uppercase alphanumeric activation code for initial signup.
  /// Unique 10-character uppercase alphanumeric activation code for initial signup.
  contractId            String                  @unique
  claimedAt             DateTime?
  /// Clerk user id of the owner who claimed this company via contract ID.
  ownerUserId           String?
  name                  String
  slug                  String                  @unique
  domain                String?
  status                CompanyStatus           @default(ACTIVE)
  blockedUntil          DateTime?
  tenantType            TenantType              @default(PARENT)
  parentCompanyId       String?                 @db.ObjectId
  parentCompany         Company?                @relation("CompanyToSubCompany", fields: [parentCompanyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childCompanies        Company[]               @relation("CompanyToSubCompany")
  infraNotifications    InfraCostNotification[] @relation(name: "InfraNotificationCompany")
  infraSubNotifications InfraCostNotification[] @relation(name: "InfraNotificationSubCompany")
  primaryUseCase        PrimaryUseCase?
  callVolume            CallVolumeRange?
  settings              Json                    @default("{}")
  /// Demo tenant for client trials; hidden from admin panel and reusable contract ID.
  isDemo                Boolean                 @default(false)
  /// Human-readable company label used in public IDs (e.g. PNX, TPO). Set at creation; treat as immutable.
  cli                   String                  @unique
  /// Auto-generated immutable internal company code (admin use only; not used in campaign public IDs).
  companyCode           String                  @unique
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  members                    CompanyMember[]
  resourceSequences          CompanyResourceSequence[]
  invitations                Invitation[]
  leadSources                LeadSource[]
  pipelineStages             LeadPipelineStage[]
  leads                      Lead[]
  phoneNumbers               PhoneNumber[]
  uploadedContacts           UploadedContact[]
  aiAgents                   AiAgent[]
  callLogs                   CallLog[]
  outboundCampaigns          OutboundCampaign[]
  analyticsSnapshots         AnalyticsSnapshot[]
  schedulerEvents            SchedulerEvent[]
  integrations               Integration[]
  webhookEndpoints           WebhookEndpoint[]
  auditLogs                  AuditLog[]
  notifications              Notification[]
  csvImportBatches           CsvImportBatch[]
  apiKeys                    ApiKey[]
  creditBalance              CreditBalance?
  creditUsages               CreditUsage[]
  billingSubscription        BillingSubscription?
  billingInvoices            BillingInvoice[]
  systemEvents               SystemEvent[]
  roles                      Role[]
  knowledgeSources           KnowledgeSource[]
  agentPromptTemplates       AgentPromptTemplate[]
  contact                    CompanyContact?
  setupConfig                CompanySetupConfig?
  channels                   CompanyChannel[]
  billingRates               CompanyBillingRates?
  dialerChannels             Channel[]
  dialerCalls                DialerCall[]
  campaigns                  Campaign[]
  campaignExecutions         CampaignExecution[]
  agentCommunicationChannels AgentCommunicationChannel[]
  campaignInvitations        CampaignInvitation[]
  supportRequests            SupportRequest[]
  billingQuotes              BillingQuote[]
  callInternalNotes          CallInternalNote[]

  @@index([status])
  @@index([clerkOrganizationId])
  @@index([isDemo])
}

model CompanyResourceSequence {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String @db.ObjectId
  resourceType String
  lastSequence Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, resourceType])
  @@index([companyId])
}

model User {
  id                   String     @id @default(auto()) @map("_id") @db.ObjectId
  clerkUserId          String     @unique
  email                String     @unique
  firstName            String?
  lastName             String?
  imageUrl             String?
  phone                String?
  passwordHash         String?
  status               UserStatus @default(ACTIVE)
  lastLoginAt          DateTime?
  resetPasswordOtp     String?
  resetPasswordExpires DateTime?
  failedLoginAttempts  Int?       @default(0)
  lockedUntil          DateTime?
  requirePasswordReset Boolean?   @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  memberships       CompanyMember[]
  invitationsSent   Invitation[]       @relation("InvitedBy")
  assignedLeads     Lead[]             @relation("LeadAssignee")
  leadAssignments   LeadAssignment[]   @relation("AssignmentTarget")
  leadAssignmentsBy LeadAssignment[]   @relation("AssignmentActor")
  leadNotes         LeadNote[]
  leadActivities    LeadActivity[]
  assignedCalls     CallLog[]          @relation("CallHumanAgent")
  schedulerEvents   SchedulerEvent[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  callInternalNotes CallInternalNote[]
  supportRequests   SupportRequest[]
  apiKeysCreated    ApiKey[]

  @@index([status])
}

model CompanyMember {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  companyId          String             @db.ObjectId
  userId             String             @db.ObjectId
  roleId             String?            @db.ObjectId
  role               UserRole           @default(AGENT)
  status             MemberStatus       @default(ACTIVE)
  jobTitle           String?
  campaignAccessType CampaignAccessType @default(ALL)
  invitedAt          DateTime?
  joinedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole     Role?                  @relation(fields: [roleId], references: [id])
  campaignAccess MemberCampaignAccess[]

  @@unique([companyId, userId])
  @@index([companyId, role])
  @@index([companyId, status])
}

model MemberCampaignAccess {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  memberId   String   @db.ObjectId
  campaignId String   @db.ObjectId
  createdAt  DateTime @default(now())

  member   CompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([memberId, campaignId])
  @@index([memberId])
  @@index([campaignId])
}

model Invitation {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  companyId           String             @db.ObjectId
  email               String
  role                UserRole           @default(AGENT)
  roleId              String?            @db.ObjectId
  jobTitle            String?
  campaignAccessType  CampaignAccessType @default(ALL)
  campaignIds         String[]           @default([])
  token               String             @unique
  clerkInvitationId   String?
  clerkOrganizationId String?
  status              InvitationStatus   @default(PENDING)
  expiresAt           DateTime
  invitedById         String             @db.ObjectId
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([companyId, email])
  @@index([companyId, status])
}

model PendingApproval {
  id         String                @id @default(auto()) @map("_id") @db.ObjectId
  email      String                @unique
  domain     String?
  status     PendingApprovalStatus @default(PENDING)
  remindedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([status])
}

// ─── Leads Management ────────────────────────────────────────────────────────

model LeadSource {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String         @db.ObjectId
  name       String
  type       LeadSourceType @default(MANUAL)
  isActive   Boolean        @default(true)
  externalId String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads   Lead[]

  @@index([companyId, isActive])
}

model LeadPipelineStage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  name      String
  slug      String
  order     Int
  color     String?
  isDefault Boolean  @default(false)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads   Lead[]

  @@unique([companyId, slug])
  @@index([companyId, order])
}

model Lead {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  companyId         String             @db.ObjectId
  stageId           String             @db.ObjectId
  sourceId          String?            @db.ObjectId
  assignedUserId    String?            @db.ObjectId
  firstName         String?
  lastName          String?
  email             String?
  phone             String?
  companyName       String?
  temperature       LeadTemperature?
  score             Int                @default(0)
  customFields      Json               @default("{}")
  tags              String[]           @default([])
  lastContactedAt   DateTime?
  nextFollowUpAt    DateTime?
  queueStatus       CallingQueueStatus @default(PENDING)
  assignedAiAgentId String?            @db.ObjectId
  lockedAt          DateTime?
  channelId         String?            @db.ObjectId
  campaignId        String?            @db.ObjectId
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stage           LeadPipelineStage @relation(fields: [stageId], references: [id])
  source          LeadSource?       @relation(fields: [sourceId], references: [id])
  assignedUser    User?             @relation("LeadAssignee", fields: [assignedUserId], references: [id])
  assignedAiAgent AiAgent?          @relation("DialerLeadAgent", fields: [assignedAiAgentId], references: [id])
  dialerChannel   Channel?          @relation(fields: [channelId], references: [id])
  campaign        Campaign?         @relation(fields: [campaignId], references: [id])
  assignments     LeadAssignment[]
  notes           LeadNote[]
  activities      LeadActivity[]
  callLogs        CallLog[]
  schedulerEvents SchedulerEvent[]
  dialerCalls     DialerCall[]

  @@index([companyId, stageId])
  @@index([companyId, assignedUserId])
  @@index([companyId, phone])
  @@index([companyId, email])
  @@index([companyId, lastContactedAt])
  @@index([companyId, createdAt])
  @@index([companyId, queueStatus, createdAt])
  @@index([companyId, campaignId])
}

model LeadAssignment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId       String   @db.ObjectId
  assignedToId String   @db.ObjectId
  assignedById String   @db.ObjectId
  reason       String?
  assignedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lead       Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User @relation("AssignmentTarget", fields: [assignedToId], references: [id])
  assignedBy User @relation("AssignmentActor", fields: [assignedById], references: [id])

  @@index([leadId, assignedAt])
}

model LeadNote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId     String   @db.ObjectId
  authorId   String   @db.ObjectId
  content    String
  isInternal Boolean  @default(true)
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId, createdAt])
}

model LeadActivity {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  leadId    String           @db.ObjectId
  type      LeadActivityType
  actorId   String?          @db.ObjectId
  summary   String
  metadata  Json             @default("{}")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([leadId, createdAt])
}

// ─── Call Logs ─────────────────────────────────────────────────────────────────

model PhoneNumber {
  id                     String            @id @default(auto()) @map("_id") @db.ObjectId
  companyId              String?           @db.ObjectId
  assignedParentTenantId String?           @db.ObjectId
  /// Entity ID segment for public IDs (e.g. PH000001). Formerly resourceKey.
  phoneNumberId          String
  /// Full external ID (e.g. v1.PNX.CP000001.PH000001).
  publicId               String
  number                 String
  channels               Int?
  label                  String?
  provider               TelephonyProvider
  campaignId             String?           @db.ObjectId
  inboundAgentId         String?           @db.ObjectId
  outboundAgentId        String?           @db.ObjectId
  agentUrl               String?
  direction              CallDirection?
  status                 PhoneNumberStatus @default(ACTIVE)
  inboundCallsCount      Int               @default(0)
  outboundCallsCount     Int               @default(0)
  lastActivityAt         DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  company            Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  campaign           Campaign?        @relation(fields: [campaignId], references: [id])
  inboundAgent       AiAgent?         @relation("InboundAgent", fields: [inboundAgentId], references: [id])
  outboundAgent      AiAgent?         @relation("OutboundAgent", fields: [outboundAgentId], references: [id])
  callLogs           CallLog[]
  channelAssignments CompanyChannel[]

  @@unique([companyId, campaignId, number])
  @@unique([companyId, phoneNumberId])
  @@unique([companyId, publicId])
  @@index([companyId, status])
  @@index([publicId])
}

model UploadedContact {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String   @db.ObjectId
  /// Public ID resource segment (e.g. CT000001).
  resourceKey String
  phone       String
  /// Excel column: user_name
  field1      String?
  /// Excel column: Recording URL
  field2      String?
  /// Excel column: Transcripts
  field3      String?
  campaignIds String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, phone])
  @@unique([companyId, resourceKey])
  @@index([companyId, createdAt])
}

model CallLog {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  companyId           String?       @db.ObjectId
  /// Entity ID segment for public IDs (e.g. CL00000001). Formerly resourceKey.
  callLogId           String
  /// Full external ID (e.g. v1.PNX.CP000001.CL00000001).
  publicId            String
  leadId              String?       @db.ObjectId
  phoneNumberId       String?       @db.ObjectId
  aiAgentId           String?       @db.ObjectId
  assignedUserId      String?       @db.ObjectId
  campaignId          String?       @db.ObjectId
  direction           CallDirection
  status              CallStatus
  outcome             CallOutcome?
  startedAt           DateTime
  durationSeconds     Int           @default(0)
  recordingUrl        String?
  transcriptUrl       String?
  aiSummary           Json?
  sentiment           Json?
  engagement          Json?
  reactivationPlan    Json?
  cost                Float?
  creditsUsed         Float?
  provider            String?
  providerStatus      String?
  providerCallId      String?
  historicalDidString String?
  historicalChannels  Int?
  correlationId       String?
  providerRequestedAt DateTime?
  providerAcceptedAt  DateTime?
  providerCompletedAt DateTime?
  answeredAt          DateTime?
  endedAt             DateTime?
  disconnectReason    String?
  providerRequest     Json?
  providerResponse    Json?
  providerWebhook     Json?
  providerMetadata    Json?
  retryNumber         Int           @default(0)
  parentCallLogId     String?       @db.ObjectId
  isRetry             Boolean       @default(false)
  retryReason         CallStatus?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  company        Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead           Lead?                  @relation(fields: [leadId], references: [id])
  phoneNumber    PhoneNumber?           @relation(fields: [phoneNumberId], references: [id])
  aiAgent        AiAgent?               @relation(fields: [aiAgentId], references: [id])
  assignedUser   User?                  @relation("CallHumanAgent", fields: [assignedUserId], references: [id])
  campaign       Campaign?              @relation(fields: [campaignId], references: [id])
  parentCallLog  CallLog?               @relation("CallLogRetries", fields: [parentCallLogId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childRetries   CallLog[]              @relation("CallLogRetries")
  transcript     CallTranscript?
  internalNotes  CallInternalNote[]
  providerEvents CallLogProviderEvent[]

  @@unique([companyId, callLogId])
  @@unique([companyId, publicId])
  @@index([companyId, startedAt])
  @@index([companyId, direction, startedAt])
  @@index([companyId, direction, status, startedAt])
  @@index([companyId, status, startedAt])
  @@index([companyId, leadId])
  @@index([companyId, aiAgentId])
  @@index([companyId, assignedUserId])
  @@index([companyId, campaignId])
  @@index([parentCallLogId])
  @@index([campaignId, phoneNumberId, isRetry])
  @@index([publicId])
}

model CallLogProviderEvent {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  callLogId       String   @db.ObjectId
  providerEventId String
  correlationId   String?
  createdAt       DateTime @default(now())

  callLog CallLog @relation(fields: [callLogId], references: [id], onDelete: Cascade)

  @@unique([callLogId, providerEventId])
  @@index([callLogId])
}

model CallTranscript {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  callLogId String   @unique @db.ObjectId
  segments  Json     @default("[]")
  fullText  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  callLog CallLog @relation(fields: [callLogId], references: [id], onDelete: Cascade)
}

model CallInternalNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  callLogId String   @db.ObjectId
