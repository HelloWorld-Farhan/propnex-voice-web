enum CampaignStage {
  MAIN
  Q1
  Q2
  Q3
}

model Campaign {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  companyId        String            @db.ObjectId
  /// Public ID resource segment (e.g. CP000001).
  resourceKey      String
  name             String
  status           CampaignStatus    @default(ACTIVE)
  direction        CampaignDirection @default(OUTBOUND)
  stage            CampaignStage     @default(MAIN)
  parentCampaignId String?           @db.ObjectId
  currentQStage    String?
  q1ScheduledAt    DateTime?
  q2ScheduledAt    DateTime?
  q3ScheduledAt    DateTime?
  qStatus          String?
  parentCampaign   Campaign?         @relation("CampaignRetries", fields: [parentCampaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childCampaigns   Campaign[]        @relation("CampaignRetries")
  address          String?
  phone            String?
  email            String?
  notes            String?
  customFields     Json              @default("{}")
  /// Per-campaign AI toggle. AI configuration is stored per campaign, not globally.
  aiEnabled        Boolean           @default(false)
  /// Campaign-specific system prompt controlling the AI agent behavior.
  systemPrompt     String?
  /// Extensible AI settings bag (model, temperature, knowledgeBase, voice, etc.).
  aiConfig         Json              @default("{}")
  lastActivityAt   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads        Lead[]
  callLogs     CallLog[]
  phoneNumbers PhoneNumber[]
  documents    CampaignDocument[]
  activities   CampaignActivity[]
  memberAccess MemberCampaignAccess[]
  agents       AiAgent[]
  invitation   CampaignInvitation?
  apiKeyAccess ApiKeyCampaignAccess[]
  execution    CampaignExecution?

  @@unique([companyId, resourceKey])
  @@index([companyId, status])
  @@index([companyId, name])
  @@index([companyId, lastActivityAt])
  @@index([companyId, aiEnabled])
  @@index([companyId, direction])
  @@index([parentCampaignId])
}

model CampaignExecution {
  id                     String                  @id @default(auto()) @map("_id") @db.ObjectId
  companyId              String                  @db.ObjectId
  campaignId             String                  @unique @db.ObjectId
  status                 CampaignExecutionStatus @default(DRAFT)
  scheduledAt            DateTime?
  startedAt              DateTime?
  pausedAt               DateTime?
  completedAt            DateTime?
  failedAt               DateTime?
  cancelledAt            DateTime?
  lastProcessedContactId String?                 @db.ObjectId
  processedCount         Int                     @default(0)
  totalContacts          Int                     @default(0)
  workerId               String?
  lockExpiresAt          DateTime?
  correlationId          String?
  failureReason          String?
  statsQueued            Int                     @default(0)
  statsDialing           Int                     @default(0)
  statsAnswered          Int                     @default(0)
  statsBusy              Int                     @default(0)
  statsNoAnswer          Int                     @default(0)
  statsFailed            Int                     @default(0)
  statsCompleted         Int                     @default(0)
  estimatedCompletionAt  DateTime?
  retryEnabled           Boolean                 @default(true)
  maxRetries             Int                     @default(3)
  retryDelaySeconds      Int                     @default(300)
  retryOnBusy            Boolean                 @default(true)
  retryOnNoAnswer        Boolean                 @default(true)
  retryOnFailed          Boolean                 @default(true)
  retryOnCancelled       Boolean                 @default(false)
  retryOnVoicemail       Boolean                 @default(false)
  retryOnMissed          Boolean                 @default(true)
  completedContactsCount Int                     @default(0)
  totalRetries           Int                     @default(0)
  pendingRetries         Int                     @default(0)
  completedRetries       Int                     @default(0)
  failedRetries          Int                     @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([status, scheduledAt])
}

model ContactRetryJob {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  companyId        String                @db.ObjectId
  campaignId       String                @db.ObjectId
  parentCallLogId  String                @db.ObjectId
  phoneNumber      String
  retryNumber      Int
  retryReason      CallStatus
  correlationId    String?
  scheduledAt      DateTime
  status           ContactRetryJobStatus @default(PENDING)
  createdCallLogId String?               @db.ObjectId
  skipReason       String?
  processedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([parentCallLogId])
  @@index([status, scheduledAt])
  @@index([campaignId, status])
  @@index([companyId, campaignId])
}

model CampaignDocument {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String   @db.ObjectId
  campaignId   String   @db.ObjectId
  name         String
  url          String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

model CampaignActivity {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String   @db.ObjectId
  campaignId String   @db.ObjectId
  type       String
  summary    String
  actorId    String?  @db.ObjectId
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

enum CampaignInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model CampaignInvitation {
  id                  String                   @id @default(auto()) @map("_id") @db.ObjectId
  companyId           String                   @db.ObjectId
  campaignId          String                   @unique @db.ObjectId
  email               String
  token               String                   @unique
  clerkInvitationId   String?
  clerkOrganizationId String?
  status              CampaignInvitationStatus @default(PENDING)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  sentAt              DateTime                 @default(now())
  acceptedAt          DateTime?
  expiresAt           DateTime

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model FormSubmission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  formType  String // "DEMO_CALL" or "PARTNER_APP"
  name      String
  email     String
  phone     String
  company   String?
  industry  String?
  clients   String? // For Partner App
  volume    String? // For Partner App
  createdAt DateTime @default(now())
}

// ─── Jobs & Careers ─────────────────────────────────────────────────────────

model JobPosting {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  jobId            String   @unique
  title            String
  description      String
  experience       String
  responsibilities String
  knowledge        String
  education        String
  jobType          String?  @default("Full-time")
  location         String?  @default("Remote")
  lastDate         DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  applications JobApplication[]
}

model JobApplication {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  jobId          String   @db.ObjectId
  firstName      String
  lastName       String
  email          String
  countryCode    String?
  phone          String
  experience     String
  expectedPayout String
  currentPayout  String?
  sponsor        String?
  legalStatus    String?
  citizenship    String?
  gender         String?
  resumeUrl      String
  agreedToTerms  Boolean  @default(true)
  isRead         Boolean  @default(false)
  status         String   @default("PENDING")
  appliedAt      DateTime @default(now())

  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model InfraCostNotification {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  email          String?
  companyId      String? @db.ObjectId
  subCompanyId   String? @db.ObjectId
  companyName    String?
  subCompanyName String?

  startDate      DateTime
  endDate        DateTime
  recurrenceType String   @default("ONCE")
  customMonths   Int[]    @default([])
  message        String?

  pausedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company? @relation(name: "InfraNotificationCompany", fields: [companyId], references: [id], onDelete: Cascade)
  subCompany Company? @relation(name: "InfraNotificationSubCompany", fields: [subCompanyId], references: [id], onDelete: Cascade)
}

model WhiteLabelDomain {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  domain       String   @unique
  companyName  String
  tabTitle     String?
  supportEmail String
  supportPhone String?
  logoUrl      String?
  faviconUrl   String?
  instagramUrl String?
  linkedinUrl  String?
  status       String   @default("PENDING") // PENDING, ACTIVE, STOPPED
  pagesConfig  Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OtpLog {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  type        String // signup_otp | login_otp | forgot_password | admin_2fa | vault_otp
  email       String
  otp         String
  userName    String?
  domain      String? // which white-label domain triggered this
  companyName String?
  status      String    @default("SENT") // SENT | USED | EXPIRED
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([type])
}

// Global settings — used for platform-wide controls like force logout
model GlobalSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique // e.g. "global_logout_at"
  value     String // ISO timestamp or other value
  updatedAt DateTime @updatedAt
}
